// Degradês
backgroundGradient  // surfaceBackground → surfaceElevated — fundo global do app
surfaceGradient     // surfaceCard → surfaceElevated — modais, sheets, snackbars

// Texto (dark)
textPrimary    = Color(0xFFE8EAF0)
textSecondary  = Color(0xFF8A8FA8)
textTertiary   = Color(0xFF5A5F72)
textDisabled   = Color(0xFF3A3D4A)

// Bordas
borderSubtle  = Color(0xFF1A2235)  // era 0xFF1E2130
